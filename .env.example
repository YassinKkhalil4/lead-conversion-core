NODE_ENV=production
EDGE_HOST=0.0.0.0
EDGE_PORT=8080
LOG_LEVEL=info

EDGE_POSTGRES_DB=lead_os_edge
EDGE_POSTGRES_USER=lead_os_edge_app
EDGE_POSTGRES_PASSWORD=replace-with-secret
DATABASE_URL=postgresql://lead_os_edge_app:replace-with-secret@127.0.0.1:5432/lead_os_edge

EDGE_SHARED_SECRET=replace-with-at-least-16-chars
EDGE_INTERNAL_SECRET=replace-with-at-least-16-chars

WORKER_NAME=
WORKER_KIND=runtime

RUNTIME_WORKER_ENABLED=false
DIRECT_META_WEBHOOK_ENABLED=false
DIRECT_LEAD_INGRESS_ENABLED=false
DIRECT_META_SEND_ENABLED=false
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_APPROVED_TEMPLATE_NAMES=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_STATUS_PROCESSOR_ENABLED=false
GRAPH_API_VERSION=v25.0
PUBLIC_INGRESS_RATE_LIMIT_MAX=120
PUBLIC_INGRESS_RATE_LIMIT_WINDOW_MS=60000

# Dashboard API: session-authenticated /api/* routes consumed by the Expo app.
DASHBOARD_API_ENABLED=false
DASHBOARD_SESSION_TTL_DAYS=30
DASHBOARD_SESSION_COOKIE_NAME=lcc_session
DASHBOARD_SESSION_COOKIE_SECURE=true
DASHBOARD_LOGIN_RATE_LIMIT_MAX=5
DASHBOARD_LOGIN_RATE_LIMIT_WINDOW_MS=900000

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

SEED_CONFIG_PATH=./config/seed-real-estate.json

# Backup jobs require a readable file containing the encryption password.
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_PASSWORD_FILE=/run/secrets/backup_encryption_password
RESTORE_TARGET_DATABASE_URL=
